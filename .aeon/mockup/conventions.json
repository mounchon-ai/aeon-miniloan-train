  "catalogue": [
    {
      "id": "UIC-001",
      "appliesTo": {
        "kinds": [
          "view",
          "edit",
          "delete",
          "manage",
          "command"
        ],
        "screens": "every",
        "text": "ทุกหน้าที่แสดงเป็นรายการแถว — ปุ่มประจำแถวทุกปุ่ม (ชนิด view · edit · delete · manage · command — ชนิดเป็นของ design ตั้งแต่ประตู 35)"
      },
      "rule": "ปุ่มประจำแถวอยู่คอลัมน์แรกของแถว เรียงลำดับตายตัว: view · edit · delete · manage · command",
      "readsField": "actions[] of screens.json, through the kind map (specification 7.4)",
      "prevents": "the same row actions landing in a different column on every screen, so a user re-learns each list",
      "decides": {
        "placement": "first-column",
        "order": [
          "view",
          "edit",
          "delete",
          "manage",
          "command"
        ]
      },
      "confirmedBy": "aplus191",
      "confirmedAt": "2026-09-01T15:10:58Z",
      "supersededBy": null,
      "origin": {
        "kind": "template",
        "ref": "plugins/mock/assets/conventions.seed.json",
        "pluginVersion": "0.3.0",
        "importedAt": "2026-09-01T15:06:39Z"
      }
    },
    {
      "id": "UIC-002",
      "appliesTo": {
        "kinds": [
          "view",
          "edit",
          "delete",
          "manage",
          "command"
        ],
        "screens": "every",
        "text": "ปุ่มประจำแถวทุกปุ่ม"
      },
      "rule": "แสดงเป็นไอคอน ไม่ใช่ปุ่มตัวหนังสือ และใช้ชื่อ action ที่ design ประกาศไว้ใน actions[].name เป็นชื่อสำหรับ screen reader",
      "readsField": "actions[].name",
      "prevents": "an icon with no accessible name (MV15), and a label invented by the renderer that disagrees with the declared name",
      "decides": {
        "presentation": "icon",
        "accessibleName": "declared-name"
      },
      "confirmedBy": "aplus191",
      "confirmedAt": "2026-09-01T15:10:58Z",
      "supersededBy": null,
      "boundary": "WHAT affordance appears is structure and may sit in a wireframe (an icon button, first column); HOW it looks — which glyph, which colour, how many pixels — is theme and may not (specification 7.3, the MV1 line)",
      "origin": {
        "kind": "template",
        "ref": "plugins/mock/assets/conventions.seed.json",
        "pluginVersion": "0.3.0",
        "importedAt": "2026-09-01T15:06:39Z"
      }
    },
    {
      "id": "UIC-003",
      "appliesTo": {
        "kinds": [
          "view"
        ],
        "screens": "every",
        "text": "ปุ่มประจำแถวชนิด view"
      },
      "rule": "เปิดเป็น modal ทับรายการ ไม่พาไปหน้ารายละเอียดแยก",
      "readsField": "actions[].destination",
      "prevents": "losing the list position on every detail view",
      "decides": {
        "container": "modal"
      },
      "confirmedBy": "aplus191",
      "confirmedAt": "2026-09-01T15:10:58Z",
      "supersededBy": null,
      "conflictsWith": "a declared destination of the form UI-/RPT- — reported, never applied silently; the kind-map row records the convention under notApplied and the route stays (MV14 · specification 7.5 item 1)",
      "origin": {
        "kind": "template",
        "ref": "plugins/mock/assets/conventions.seed.json",
        "pluginVersion": "0.3.0",
        "importedAt": "2026-09-01T15:06:39Z"
      }
    }
  ],
